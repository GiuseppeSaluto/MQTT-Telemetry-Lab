{
  "uid": "factory-overview",
  "title": "Factory Overview",
  "tags": [
    "mqtt-telemetry-lab"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "line",
        "label": "Line",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "timescaledb"
        },
        "query": "SELECT DISTINCT line FROM telemetry WHERE $__timeFilter(time) ORDER BY line",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "machine_id",
        "label": "Machine",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "timescaledb"
        },
        "query": "SELECT DISTINCT machine_id FROM telemetry WHERE $__timeFilter(time) AND line IN ($line) ORDER BY machine_id",
        "refresh": 2,
        "sort": 1,
        "multi": false,
        "includeAll": false
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Faults",
        "enable": false,
        "iconColor": "red",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "timescaledb"
        },
        "target": {
          "refId": "Anno",
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT time AS time, machine_id || ' fault' AS text, machine_id AS tags FROM telemetry WHERE state = 'fault' AND $__timeFilter(time) AND line IN ($line) AND machine_id = ${machine_id:sqlstring} ORDER BY time"
        }
      },
      {
        "name": "Detected Anomalies",
        "enable": true,
        "iconColor": "orange",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "timescaledb"
        },
        "target": {
          "refId": "Anno",
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT time AS time, machine_id || ' anomaly (z=' || round(greatest(abs(temperature_zscore), abs(vibration_zscore))::numeric, 1) || ')' AS text, machine_id AS tags FROM anomaly_scores($__timeFrom(), $__timeTo()) WHERE is_anomaly AND line IN ($line) AND machine_id = ${machine_id:sqlstring} ORDER BY time"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 10,
      "type": "row",
      "title": "Plant",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 11,
      "title": "Plant availability",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT 100 * sum(running_min) / nullif(sum(running_min + idle_min + fault_min), 0) AS availability FROM machine_kpis($__timeFrom(), $__timeTo()) WHERE line IN ($line)"
        }
      ],
      "description": "Running time / observed time over all selected machines and the selected range."
    },
    {
      "id": 12,
      "title": "Machines in fault now",
      "type": "stat",
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT count(*) FILTER (WHERE state = 'fault') AS in_fault FROM (SELECT DISTINCT ON (machine_id) state FROM telemetry WHERE time > now() - interval '1 minute' AND line IN ($line) ORDER BY machine_id, time DESC) latest"
        }
      ]
    },
    {
      "id": 13,
      "title": "Anomalous samples (selected range)",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT count(*) AS anomalies FROM anomaly_scores($__timeFrom(), $__timeTo()) WHERE is_anomaly AND line IN ($line)"
        }
      ]
    },
    {
      "id": 14,
      "title": "Energy (selected range)",
      "type": "stat",
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "kwatth",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT sum(energy_kwh) AS energy FROM machine_kpis($__timeFrom(), $__timeTo()) WHERE line IN ($line)"
        }
      ]
    },
    {
      "id": 15,
      "title": "Availability by line",
      "type": "bargauge",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 8,
        "h": 10
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": true
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 60
              },
              {
                "color": "green",
                "value": 75
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT line, 100 * sum(running_min) / nullif(sum(running_min + idle_min + fault_min), 0) AS availability FROM machine_kpis($__timeFrom(), $__timeTo()) WHERE line IN ($line) GROUP BY line ORDER BY line"
        }
      ]
    },
    {
      "id": 9,
      "title": "Machines, lowest availability first (selected range)",
      "description": "Availability = running time / observed time. Computed by machine_kpis() in storage/init/003_kpis.sql.",
      "type": "table",
      "gridPos": {
        "x": 8,
        "y": 5,
        "w": 16,
        "h": 10
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "availability_pct"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Availability"
              },
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "running_min"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Running"
              },
              {
                "id": "unit",
                "value": "m"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "idle_min"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Idle"
              },
              {
                "id": "unit",
                "value": "m"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "fault_min"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Fault"
              },
              {
                "id": "unit",
                "value": "m"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "energy_kwh"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Energy"
              },
              {
                "id": "unit",
                "value": "suffix: kWh"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "machine_id"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 120
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "line"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 80
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT * FROM machine_kpis($__timeFrom(), $__timeTo()) WHERE line IN ($line) ORDER BY availability_pct"
        }
      ]
    },
    {
      "id": 5,
      "title": "Machine State",
      "type": "state-timeline",
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 24,
        "h": 22
      },
      "transformations": [
        {
          "id": "partitionByValues",
          "options": {
            "fields": [
              "machine_id"
            ],
            "keepFields": false,
            "naming": {
              "asLabels": true
            }
          }
        }
      ],
      "options": {
        "mergeValues": true,
        "showValue": "never",
        "rowHeight": 0.9
      },
      "fieldConfig": {
        "defaults": {
          "displayName": "${__field.labels.machine_id}",
          "mappings": [
            {
              "type": "value",
              "options": {
                "running": {
                  "color": "green",
                  "index": 0
                },
                "idle": {
                  "color": "blue",
                  "index": 1
                },
                "fault": {
                  "color": "red",
                  "index": 2
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT time AS \"time\", machine_id, state FROM telemetry WHERE $__timeFilter(time) AND line IN ($line) ORDER BY time"
        }
      ]
    },
    {
      "id": 16,
      "type": "row",
      "title": "Machine detail: $machine_id",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 37,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
