{
  "uid": "factory-overview",
  "title": "Factory Overview",
  "tags": [
    "mqtt-telemetry-lab"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "line",
        "label": "Line",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "timescaledb"
        },
        "query": "SELECT DISTINCT line FROM telemetry ORDER BY line",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "machine_id",
        "label": "Machine",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "timescaledb"
        },
        "query": "SELECT DISTINCT machine_id FROM telemetry WHERE line IN ($line) ORDER BY machine_id",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Faults",
        "enable": true,
        "iconColor": "red",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "timescaledb"
        },
        "editorMode": "code",
        "rawQuery": true,
        "rawSql": "SELECT time AS time, machine_id || ' fault' AS text, machine_id AS tags FROM telemetry WHERE state = 'fault' AND $__timeFilter(time) AND line IN ($line) AND machine_id IN ($machine_id) ORDER BY time",
        "format": "table"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Temperature",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT time AS \"time\", machine_id, temperature FROM telemetry WHERE $__timeFilter(time) AND line IN ($line) AND machine_id IN ($machine_id) ORDER BY time"
        }
      ]
    },
    {
      "id": 2,
      "title": "Vibration",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT time AS \"time\", machine_id, vibration FROM telemetry WHERE $__timeFilter(time) AND line IN ($line) AND machine_id IN ($machine_id) ORDER BY time"
        }
      ]
    },
    {
      "id": 3,
      "title": "RPM",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "rotrpm"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT time AS \"time\", machine_id, rpm FROM telemetry WHERE $__timeFilter(time) AND line IN ($line) AND machine_id IN ($machine_id) ORDER BY time"
        }
      ]
    },
    {
      "id": 4,
      "title": "Power Consumption",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "kwatt"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT time AS \"time\", machine_id, power_consumption FROM telemetry WHERE $__timeFilter(time) AND line IN ($line) AND machine_id IN ($machine_id) ORDER BY time"
        }
      ]
    },
    {
      "id": 5,
      "title": "Machine State",
      "type": "state-timeline",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 6
      },
      "options": {
        "mergeValues": true,
        "showValue": "auto",
        "rowHeight": 0.9
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "running": {
                  "color": "green",
                  "index": 0
                },
                "idle": {
                  "color": "blue",
                  "index": 1
                },
                "fault": {
                  "color": "red",
                  "index": 2
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT time AS \"time\", machine_id, state FROM telemetry WHERE $__timeFilter(time) AND line IN ($line) AND machine_id IN ($machine_id) ORDER BY time"
        }
      ]
    },
    {
      "id": 6,
      "title": "Current Status",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "state"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "running": {
                        "color": "green",
                        "index": 0
                      },
                      "idle": {
                        "color": "blue",
                        "index": 1
                      },
                      "fault": {
                        "color": "red",
                        "index": 2
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT DISTINCT ON (machine_id) machine_id, line, state, temperature, vibration, rpm, power_consumption, time AS \"time\" FROM telemetry WHERE line IN ($line) AND machine_id IN ($machine_id) ORDER BY machine_id, time DESC"
        }
      ]
    }
  ]
}
